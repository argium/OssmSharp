<div class="@NotificationClass" role="@Role" @attributes="AdditionalAttributes">
    <span class="notice-icon" aria-hidden="true">@Icon</span>
    <div class="notice-content">@ChildContent</div>
</div>

@code {
    [Parameter] public string Variant { get; set; } = "info";
    [Parameter] public string Role { get; set; } = "status";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string NotificationClass => string.IsNullOrWhiteSpace(CssClass)
        ? $"inline-notification {Variant}"
        : $"inline-notification {Variant} {CssClass}";
    private string Icon => Variant switch
    {
        "success" => "✓",
        "warning" or "danger" => "!",
        _ => "i",
    };
}
