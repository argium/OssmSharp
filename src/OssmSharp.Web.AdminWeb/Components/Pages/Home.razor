@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using OssmSharp.Web.Client.Models

<PageTitle>User controls</PageTitle>
<ControlLayout Label="User controls" ConnectionLost="@_connectionLost">
  <ChildContent>
    @if (_state is null)
    {
      @if (_loaded)
      {
        <InlineNotification Variant="danger" Role="alert">
          @(_notice.Message ?? "Unable to connect to the user service. Reload the page.")
        </InlineNotification>
      }
    }
    else
    {
      <h1 class="visually-hidden">User controls</h1>
      @if (_notice.Message is { } message)
      {
        <InlineNotification Variant="@(_notice.IsError ? "danger" : _noticeVariant)"
                            Role="@(_notice.IsError ? "alert" : "status")">@message</InlineNotification>
      }
      <div class="user-grid connection-sensitive"
           data-device-disconnected="@(_state.Device is { IsConnected: true, IsConnecting: false } ? null : "true")">
        <section class="widget user-status device-sensitive" data-testid="user-controls" role="region"
                 aria-labelledby="controls-heading">
          <div class="widget-heading user-status-heading">
            <h2 id="controls-heading">Controls</h2>
            <span class="status-mark @GuestVariant" data-testid="guest-status">
              <i class="dot"></i>@GuestStatus
            </span>
          </div>
          <div class="button-row">
            <button type="button" class="button success"
                    disabled="@(_busy || _safetyBusy || DeviceUnavailable || _state.Device is { IsResettingPosition: true } || !_state.GuestJoined)"
                    @onclick="AllowGuest">
              Allow control
            </button>
            <button type="button" class="button danger" disabled="@(_safetyBusy || DeviceUnavailable)" @onclick="Stop">Stop</button>
            <button type="button" class="button secondary" data-reset-position-button
                    disabled="@(_busy || _safetyBusy || DeviceUnavailable || _state.Device is { IsResettingPosition: true })"
                    @onclick="ResetPosition">Reset Position</button>
            <button type="button" class="button danger" disabled="@(_safetyBusy || DeviceUnavailable || !_state.GuestJoined)" @onclick="EndGuest">
              End guest
            </button>
          </div>
          <div class="attachment-field">
            <label for="attachment-length">Attachment length</label>
            <input id="attachment-length" type="number" inputmode="decimal" data-testid="attachment-length"
                   min="0" max="@RailLengthText" step="@LengthStep" aria-describedby="attachment-length-unit"
                   disabled="@DeviceUnavailable" value="@AttachmentLengthText" @oninput="SetAttachmentLength" />
            <span id="attachment-length-unit" class="field-unit">@LengthUnitLabel (rail @RailLengthText @LengthUnitLabel)</span>
          </div>
        </section>
        <section class="widget" data-testid="device-connection" role="region" aria-labelledby="connection-heading">
          <div class="widget-heading user-status-heading">
            <h2 id="connection-heading">Device connection</h2>
            <span class="status-mark @ConnectionVariant" data-testid="device-connection-status" role="status">
              <i class="dot"></i>@ConnectionStatus
            </span>
          </div>
          <dl class="connection-details">
            <div>
              <dt>Name</dt>
              <dd data-testid="device-name">@(_state.Device?.Name ?? "Unknown")</dd>
            </div>
            <div>
              <dt>ID</dt>
              <dd data-testid="device-identifier">@(_state.Device?.Identifier ?? "Unknown")</dd>
            </div>
            <div>
              <dt>Connected duration</dt>
              <dd data-testid="device-duration"
                  data-connected-at="@(_state.Device is { IsConnected: true, IsConnecting: false } ? _state.Device.ConnectedAt?.ToString("O") : null)">
                Unknown
              </dd>
            </div>
          </dl>
          <button type="button" class="button secondary"
                  disabled="@(_busy || _safetyBusy || _connectionLost || _state.Device is { IsConnecting: true } or { IsConnected: true })"
                  @onclick="Connect">Connect device</button>
        </section>
        <section class="widget device-sensitive" data-testid="guest-invitation-card" role="region"
                 aria-labelledby="invite-heading">
          <div class="widget-heading">
            <h2 id="invite-heading">Invite a guest</h2>
          </div>
          <div class="invite-row">
            <input id="guest-invitation" type="text" aria-label="Guest invitation"
                   data-testid="invitation-link" readonly disabled="@DeviceUnavailable" value="@InvitationText" />
            <button class="button @(_notice.IsCopied ? "success" : "secondary")" type="button" disabled="@DeviceUnavailable"
                    @onclick="Copy" aria-label="@_notice.CopyLabel">@_notice.CopyLabel</button>
          </div>
        </section>
        <PatternPreview Title="Last settings" Pattern="@_state.Device?.TransmittedSettings?.Pattern"
                        Speed="@_state.Device?.TransmittedSettings?.Speed" Stroke="@_state.Device?.TransmittedSettings?.Stroke"
                        Depth="@_state.Device?.TransmittedSettings?.Depth" Sensation="@_state.Device?.TransmittedSettings?.Sensation"
                        AttachmentLength="@_attachmentLengthCm" RailLength="@Options.Value.RailLengthCm"
                        Animate="@(!_previewStopped && !_connectionLost && _state.Device is { IsConnected: true, IsConnecting: false, IsResettingPosition: false })" />
      </div>
    }
  </ChildContent>
</ControlLayout>
